<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.students.jwsystem_public.mapper.UserMapper">

    <select id="findByUsername" resultType="com.students.jwsystem_public.entity.User">
        select id, username, password, real_name, role
        from `user`
        where username = #{username}
    </select>

</mapper>